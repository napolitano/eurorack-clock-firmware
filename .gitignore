# Repository-local and generated files that must never be committed.

# PlatformIO and build output
.pio/
build/
dist/
coverage/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Generated compile databases and index caches.
# compile_commands.json contains absolute workstation paths.
compile_commands.json
.compile_commands.json
**/compile_commands.json
.cache/
.clangd/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.log

# Python caches / local test state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*

# Local environment, credentials, certificates, and secrets
.env
.env.*
!.env.example
*.local
*.secret
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks

# OS/editor leftovers
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/

# Native simulator local state and user-specific CMake overrides
.clock-simulator-state.bin
.clock-simulator-*.bin
*.simstate
CMakeUserPresets.json

# Simulator-local panel experiments / artwork overrides
sim/panel_layout.local.ini
sim/*-panel.local.bmp
sim/*-panel.local.png
sim/*-panel.local.jpg
sim/*-panel.local.jpeg

# Native simulator screenshots
clock-simulator-screenshot*.bmp
