# Local-only CLOCK tutorial publication configuration.
# Copy this file to .env and fill in your own values. .env is gitignored.

# Secret API key from your ElevenLabs account. Never commit the real value.
ELEVENLABS_API_KEY=

# Voice ID of the cloned South Signal Lab / Axel narration voice.
ELEVENLABS_VOICE_ID=

# Preferred model selector. "auto-v4" queries /v1/models at runtime and selects
# the one accessible TTS model whose ID/name contains "v4". If your account
# exposes more than one v4 model, paste the exact model ID here instead.
ELEVENLABS_MODEL_ID=auto-v4

# ElevenLabs encoded audio format used for cached narration segments.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Usually leave this at the production endpoint.
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# Visual timing reserve added after each measured narration segment.
CLOCK_TUTORIAL_BODY_HEADROOM_MS=1200
CLOCK_TUTORIAL_OPENING_MIN_MS=18000
CLOCK_TUTORIAL_CLOSING_MIN_MS=20000
CLOCK_TUTORIAL_ROUNDING_MS=100
